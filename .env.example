# EM-Bench LLM 报告撰写器（code/write_notes_llm.py）配置模板（与 enzyme_update 的 .env 同款用法）
# 用法: cp .env.example .env 后填入真实值；.env 已被 .gitignore 忽略，**真实 key 切勿提交/入库**。
# 脚本运行时自动加载本文件（已存在的环境变量优先，无需 source）。
#
# 两种写法等价，任选其一：
#   A. EM-Bench 专属变量（显式覆盖，优先级最高）
#   B. 直接粘贴 enzyme_update .env 的 DEEPSEEK_* 三个变量（两项目共用同一 API）

# 任选一个可达端点（node1 实测 2026-09-03：Anthropic/DeepSeek/Moonshot/阿里 DashScope 可达）：
#   Anthropic 原生协议:  https://api.anthropic.com/v1
#   DeepSeek:            https://api.deepseek.com/v1
#   Moonshot:            https://api.moonshot.cn/v1
#   Qwen (DashScope):    https://dashscope.aliyuncs.com/compatible-mode/v1
EMBENCH_LLM_BASE_URL=https://api.deepseek.com/v1

# API key（Anthropic 用 x-api-key 发送，OpenAI 兼容端点用 Bearer，脚本自动处理）
EMBENCH_LLM_API_KEY=sk-替换为真实key

# 模型名（示例）：deepseek-chat / moonshot-v1-8k / qwen-plus / claude-sonnet-5
EMBENCH_LLM_MODEL=deepseek-chat

# 可选参数（默认 4096 / 0.3）
# EMBENCH_LLM_MAX_TOKENS=4096
# EMBENCH_LLM_TEMPERATURE=0.3

# ---- 或（B）与 enzyme_update .env 完全相同的变量 ----
# DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-chat
